{
  "uid": "bip-overview",
  "title": "bip: overview",
  "tags": [
    "bip"
  ],
  "timezone": "America/New_York",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "type": "row",
      "title": "Site (discobiscuits.net)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests per minute",
      "id": 2,
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(count_over_time({container=\"kamal-proxy\"} | json | service=\"bip-web-web\" [1m]))",
          "legendFormat": "requests",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Response time (ms)",
      "id": 3,
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "quantile_over_time(0.5, {container=\"kamal-proxy\"} | json | service=\"bip-web-web\" | unwrap duration | __error__=\"\" [5m]) by (service) / 1e6",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          }
        },
        {
          "expr": "quantile_over_time(0.95, {container=\"kamal-proxy\"} | json | service=\"bip-web-web\" | unwrap duration | __error__=\"\" [5m]) by (service) / 1e6",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          }
        },
        {
          "expr": "quantile_over_time(0.99, {container=\"kamal-proxy\"} | json | service=\"bip-web-web\" | unwrap duration | __error__=\"\" [5m]) by (service) / 1e6",
          "legendFormat": "p99",
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {},
      "description": "From kamal-proxy, so it includes everything the app does for a request."
    },
    {
      "type": "timeseries",
      "title": "Errors (5xx) per 5 min",
      "id": 4,
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (status) (count_over_time({container=\"kamal-proxy\"} | json | service=\"bip-web-web\" | status >= 500 [5m]))",
          "legendFormat": "{{status}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "table",
      "title": "Slowest pages (average over the time range)",
      "id": 5,
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "expr": "topk(20, avg by (path) (avg_over_time({container=\"kamal-proxy\"} | json | service=\"bip-web-web\" | unwrap duration | __error__=\"\" [$__range]))) / 1e6",
          "queryType": "instant",
          "instant": true,
          "legendFormat": "{{path}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Last *",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "type": "logs",
      "title": "App errors",
      "id": 6,
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "expr": "{service=\"bip-web\"} |= \"\\\"level\\\":\\\"error\\\"\"",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "type": "row",
      "title": "Server",
      "id": 7,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Memory available",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 4,
        "h": 6
      },
      "targets": [
        {
          "expr": "max(node_memory_MemAvailable_bytes)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 500000000.0
              },
              {
                "color": "green",
                "value": 800000000.0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Resize the server if this stays under 500 MB."
    },
    {
      "type": "stat",
      "title": "Disk free",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 4,
        "y": 20,
        "w": 4,
        "h": 6
      },
      "targets": [
        {
          "expr": "max(node_filesystem_avail_bytes{mountpoint=\"/\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 10000000000.0
              },
              {
                "color": "green",
                "value": 20000000000.0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "CPU used",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
          "legendFormat": "cpu",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Load average",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "max(node_load1)",
          "legendFormat": "1m",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          }
        },
        {
          "expr": "max(node_load15)",
          "legendFormat": "15m",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Memory per container",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (app) (label_replace(container_memory_working_set_bytes{name!=\"\"}, \"app\", \"$1\", \"name\", \"(.+?)(-[0-9a-f]{40})?\"))",
          "legendFormat": "{{app}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "CPU per container (cores)",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (app) (label_replace(rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]), \"app\", \"$1\", \"name\", \"(.+?)(-[0-9a-f]{40})?\"))",
          "legendFormat": "{{app}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "title": "Postgres (bip)",
      "id": 14,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Connections",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{datname=\"bip\"}",
          "legendFormat": "connections",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Cache hit rate",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 6,
        "y": 35,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_blks_hit{datname=\"bip\"}[5m]) / (rate(pg_stat_database_blks_hit{datname=\"bip\"}[5m]) + rate(pg_stat_database_blks_read{datname=\"bip\"}[5m]))",
          "legendFormat": "hit rate",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "description": "Under about 99% means queries are reading from disk."
    },
    {
      "type": "timeseries",
      "title": "Transactions per second",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname=\"bip\"}[5m])",
          "legendFormat": "commits",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          }
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"bip\"}[5m])",
          "legendFormat": "rollbacks",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "title": "Database size",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 18,
        "y": 35,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname=\"bip\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "table",
      "title": "Queries by total time (over the time range)",
      "id": 19,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "topk(20, sum by (query) (increase(pg_stat_statements_seconds_total{datname=\"bip\"}[$__range])))",
          "queryType": "instant",
          "instant": true,
          "format": "table",
          "legendFormat": "{{query}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          }
        },
        {
          "expr": "topk(20, sum by (query) (increase(pg_stat_statements_seconds_total{datname=\"bip\"}[$__range])) / sum by (query) (increase(pg_stat_statements_calls_total{datname=\"bip\"}[$__range])))",
          "queryType": "instant",
          "instant": true,
          "format": "table",
          "legendFormat": "{{query}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "From pg_stat_statements. Total = time spent on the query in the range; mean = per call.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "total",
              "Value #B": "mean per call"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "total",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Redis",
      "id": 20,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
