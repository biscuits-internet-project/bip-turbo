      "title": "Site (discobiscuits.net)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sum(count_over_time({container=\"kamal-proxy\"} | json | service=\"bip-web-web\" [1m]))",
          "legendFormat": "requests",
          "refId": "A"
        }
      ],
      "title": "Requests per minute",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "description": "From kamal-proxy, so it includes everything the app does for a request.",
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "id": 3,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "quantile_over_time(0.5, {container=\"kamal-proxy\"} | json | service=\"bip-web-web\" | unwrap duration | __error__=\"\" [5m]) by (service) / 1e6",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "quantile_over_time(0.95, {container=\"kamal-proxy\"} | json | service=\"bip-web-web\" | unwrap duration | __error__=\"\" [5m]) by (service) / 1e6",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "quantile_over_time(0.99, {container=\"kamal-proxy\"} | json | service=\"bip-web-web\" | unwrap duration | __error__=\"\" [5m]) by (service) / 1e6",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "Response time (ms)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "id": 4,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sum by (status) (count_over_time({container=\"kamal-proxy\"} | json | service=\"bip-web-web\" | status >= 500 [5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "title": "Errors (5xx) per 5 min",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 5,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "topk(20, avg by (path) (avg_over_time({container=\"kamal-proxy\"} | json | service=\"bip-web-web\" | unwrap duration | __error__=\"\" [$__range]))) / 1e6",
          "instant": true,
          "legendFormat": "{{path}}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Slowest pages (average over the time range)",
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": ["lastNotNull"]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": true,
                "field": "Last *"
              }
            ]
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 6,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "{service=\"bip-web\"} |= \"\\\"level\\\":\\\"error\\\"\"",
          "refId": "A"
        }
      ],
      "title": "App errors",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "id": 41,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sum by (message, error_type) (count_over_time({service=\"bip-web\"} |= \"\\\"level\\\":\\\"error\\\"\" | json message=\"message\", error_type=\"error.name\" [$__auto]))",
          "legendFormat": "{{message}} ({{error_type}})",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "App errors over time",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "id": 42,
      "options": {
        "sortBy": [
          {
            "desc": true,
            "displayName": "Count"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sort_desc(sum by (message, error_type) (count_over_time({service=\"bip-web\"} |= \"\\\"level\\\":\\\"error\\\"\" | json message=\"message\", error_type=\"error.name\" [$__range])))",
          "legendFormat": "{{message}} ({{error_type}})",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Errors by type",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "Time": true,
              "id": true,
              "labels": true,
              "tsNs": true
            },
            "renameByName": {
              "message": "Error",
              "error_type": "Type",
              "Value #A": "Count"
            }
          }
        }
      ],
      "type": "table"
    },
