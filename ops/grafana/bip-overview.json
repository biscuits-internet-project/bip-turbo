    {
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "description": "From pg_stat_statements. Total = time spent on the query in the range; mean = per call.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 57
      },
      "id": 19,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "topk(20, sum by (queryid) (increase(pg_stat_statements_seconds_total{datname=\"bip\"}[$__range]))) * on (queryid) group_left(query) max by (queryid, query) (pg_stat_statements_query_id)",
          "format": "table",
          "instant": true,
          "legendFormat": "{{query}}",
          "queryType": "instant",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "(sum by (queryid) (increase(pg_stat_statements_seconds_total{datname=\"bip\"}[$__range])) / sum by (queryid) (increase(pg_stat_statements_calls_total{datname=\"bip\"}[$__range]))) * on (queryid) group_left(query) max by (queryid, query) (pg_stat_statements_query_id)",
          "format": "table",
          "instant": true,
          "legendFormat": "{{query}}",
          "queryType": "instant",
          "refId": "B"
        }
      ],
      "title": "Queries by total time (over the time range)",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "queryid": true
            },
            "renameByName": {
              "Value #A": "total",
              "Value #B": "mean per call"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": true,
                "field": "total"
              }
            ]
          }
        }
      ],
      "type": "table"
    },
