      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Cache hit rate",
      "id": 22,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 8,
        "y": 54,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m]))",
          "legendFormat": "hit rate",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Clients",
      "id": 23,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 16,
        "y": 54,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "redis_connected_clients",
          "legendFormat": "clients",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "title": "Backups",
      "id": 24,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "Backup logs (nightly Postgres, weekly Supabase auth)",
      "id": 25,
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 61,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "{job=\"backups\"}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}