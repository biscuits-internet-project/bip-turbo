  {
    "uid": "bip-low-memory",
    "title": "Server memory low",
    "ruleGroup": "bip",
    "folderUID": "bip",
    "condition": "C",
    "data": [
      {
        "refId": "A",
        "datasourceUid": "grafanacloud-prom",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "model": {
          "refId": "A",
          "expr": "max(node_memory_MemAvailable_bytes)",
          "instant": true
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "model": {
          "refId": "B",
          "type": "reduce",
          "expression": "A",
          "reducer": "last"
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "B",
          "conditions": [
            {
              "evaluator": {
                "type": "lt",
                "params": [500000000.0]
              }
            }
          ]
        }
      }
    ],
    "noDataState": "OK",
    "execErrState": "Error",
    "for": "10m",
    "isPaused": false,
    "annotations": {
      "summary": "Under 500 MB of memory available for 10 minutes. Consider the next Hetzner size up.",
      "runbook_url": "https://github.com/biscuits-internet-project/bip-turbo/blob/main/ops/postgres/README.md"
    },
    "labels": {
      "app": "bip"
    }
  },
