[
  {
    "uid": "bip-backup-error",
    "title": "Backup failed",
    "ruleGroup": "bip",
    "folderUID": "bip",
    "condition": "C",
    "data": [
      {
        "refId": "A",
        "datasourceUid": "grafanacloud-logs",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "model": {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"backups\"} |= \"ERROR\" [1h]))",
          "instant": true,
          "queryType": "instant"
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "model": {
          "refId": "B",
          "type": "reduce",
          "expression": "A",
          "reducer": "last"
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "B",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [0]
              }
            }
          ]
        }
      }
    ],
    "noDataState": "OK",
    "execErrState": "Error",
    "for": "0s",
    "isPaused": false,
    "annotations": {
      "summary": "A backup logged ERROR in the last hour. Check ~/backups/*.log on the server.",
      "runbook_url": "https://github.com/biscuits-internet-project/bip-turbo/blob/main/ops/postgres/README.md"
    },
    "labels": {
      "app": "bip"
    }
  },
